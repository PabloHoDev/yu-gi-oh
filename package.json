{
  "name": "duel-academy",
  "private": true,
  "version": "0.2.0",
  "description": "Fan game de Yu-Gi-Oh! GX no estilo dos RPGs de Game Boy Advance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "biome check && tsc --noEmit && vitest run && vite build",
    "cards:import": "node scripts/import-cards.ts",
    "cards:report": "node scripts/cards-report.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^4.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
